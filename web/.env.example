# Postgres connection (use Neon free tier or local Docker postgres)
DATABASE_URL=postgres://user:pass@host:5432/codetama

# GitHub OAuth (create at https://github.com/settings/developers)
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Auth.js secret (run: openssl rand -base64 32)
AUTH_SECRET=
AUTH_TRUST_HOST=true

# Public URL (Auth.js callback uses this)
AUTH_URL=http://localhost:3000

# Minutes a user must wait between attacks. 0 disables the cooldown.
# Default if unset: 60.
ATTACK_COOLDOWN_MINUTES=60
