{
  "name": "codetama",
  "version": "0.2.2",
  "description": "A digital pet that lives in your Claude Code session — every prompt is food.",
  "type": "module",
  "bin": {
    "codetama": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "web:dev": "npm --prefix web run dev",
    "web:build": "npm --prefix web run build",
    "web:start": "npm --prefix web run start",
    "web:typecheck": "npm --prefix web run typecheck",
    "web:db:generate": "npm --prefix web run db:generate",
    "web:db:migrate": "npm --prefix web run db:migrate"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "claude-code",
    "tamagotchi",
    "cli",
    "tui",
    "codetama"
  ],
  "homepage": "https://codetama.com",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.14",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "ink": "^7.0.2",
    "react": "^19.2.6"
  }
}
